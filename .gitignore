# --- Entornos virtuales y dependencias ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Datos ---
# El CONTENIDO nunca se versiona: los logs de entrada y el reporte de salida
# llevan informacion de usuarios reales.
#
# Las CARPETAS si aparecen en GitHub, gracias al .gitkeep: al clonar el
# repositorio ya existe data/input/ donde dejar los .log, sin tener que crearla
# a mano ni adivinar el nombre.
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep

# Logs sueltos fuera de data/input/ (por ejemplo, dejados en la raiz por error)
*.log

# Excepcion: los logs de ejemplo de las pruebas SI se versionan. Estan recortados
# de datos reales ya anonimizados y sin ellos la suite no puede ejecutarse.
!tests/fixtures/logs/*.log

# --- Notebooks ---
.ipynb_checkpoints/

# --- Herramientas ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Artefactos de Windows / WSL ---
# Al copiar archivos desde Windows, NTFS crea flujos alternativos ":Zone.Identifier".
*:Zone.Identifier
Thumbs.db
.DS_Store

# --- Editores ---
.vscode/
.idea/
